============================================================
a buscar.'
        );
    }

    const respuesta = await axios.get(
        API_URL,
        {
            params: {
                q: query,
                apiKey: API_KEY
            },

            timeout: 60000,

            headers: {
                Accept: 'application/json',
                'User-Agent': 'AlexBot/1.0'
            }
        }
    );

    const data = respuesta?.data;

    console.log(
        '[YT] Respuesta API:',
        JSON.stringify(data).slice(0, 1500)
    );

    // ========================================================
    // VALIDAR RESPUESTA
    // ========================================================
    //
    // La API devuelve:
    //
    // {
    //   status: true,
    //   creator: "...",
    //   result: [...]
    // }
    //
    // NO devuelve status: 200.
    // ========================================================

    if (
        !data ||
        data.status !== true ||
        !Array.isArray(data.result)
    ) {

        throw new Error(
            data?.message ||
            'La API no devolvió resultados válidos.'
        );
    }

    if (data.result.length === 0) {

        throw new Error(
            'No se encontraron resultados.'
        );
    }

    return data.result;
}

